from collections import deque

# Graph representing the server network
graph = {
    "Master": ["S1", "S2"],
    "S1": ["S3", "S4"],
    "S2": ["S5", "S6"],
    "S3": [],
    "S4": ["S7"],
    "S5": [],
    "S6": [],
    "S7": []
}


def bfs(graph, start):
    visited = set()
    queue = deque([start])

    visited.add(start)

    print("Cache invalidation order:")

    while queue:
        node = queue.popleft()
        print(node, end=" ")

        for neighbour in graph[node]:
            if neighbour not in visited:
                visited.add(neighbour)
                queue.append(neighbour)


# Start BFS from Master Server
bfs(graph, "Master")
